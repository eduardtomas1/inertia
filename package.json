{
  "name": "inertia",
  "version": "0.0.11",
  "description": "A calm local workspace for coding with agents.",
  "desktopName": "dev.inertia.app.desktop",
  "main": "out/main/index.js",
  "author": "Eduard Tomas Velez",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "npm run notices:generate",
    "build": "npm run typecheck && electron-vite build",
    "build:bundle": "electron-vite build",
    "preview": "electron-vite preview",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "npm run lint:standard && npm run lint:type-aware",
    "lint:standard": "oxlint src scripts tests --react-plugin --report-unused-disable-directives --deny-warnings",
    "lint:type-aware": "oxlint src scripts tests --type-aware -A all -D typescript/no-floating-promises -D typescript/no-misused-promises -D typescript/await-thenable --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.unit.json && tsc --noEmit -p tsconfig.test.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:portable": "vitest run tests/main/runtime-process-protocol.test.ts tests/main/runtime-supervisor.test.ts tests/server/process-lifecycle.test.ts tests/server/providers.test.ts tests/server/provider-metadata.test.ts tests/server/agent-harness.test.ts tests/server/codex-app-server.test.ts tests/server/claude-agent-sdk-harness.test.ts tests/server/cursor-acp-harness.test.ts tests/server/opencode-sdk-harness.test.ts",
    "test:windows-codex": "vitest run tests/server/windows-codex-core.test.ts tests/server/windows-codex-discovery.test.ts",
    "test:linux-package": "vitest run tests/main/linux-packaging.test.ts tests/main/runtime-assets.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:package-smoke": "node scripts/package-smoke.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "validate:linux-package": "node scripts/validate-linux-package.mjs",
    "verify:fuses": "node scripts/verify-electron-fuses.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "screenshots:readme": "npm run build && node scripts/capture-readme-screenshots.mjs",
    "check": "npm run check:architecture && npm run lint && npm run typecheck && npm run test && npm run build:bundle",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:release:mac": "npm run build && electron-builder --config scripts/electron-builder.release.cjs --mac --arm64 --publish never",
    "dist:release:win": "npm run build && electron-builder --config scripts/electron-builder.release.cjs --win --x64 --publish never",
    "dist:release:linux": "npm run build && electron-builder --config scripts/electron-builder.release.cjs --linux AppImage --x64 --publish never",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-node-pty-helper.mjs"
  },
  "build": {
    "appId": "dev.inertia.app",
    "productName": "Inertia",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons/512x512.png",
        "to": "icons/inertia.png"
      },
      {
        "from": "resources/generated/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "electron/LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "electron/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "artifactName": "Inertia.Setup.${version}.${ext}",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/icons",
      "category": "Development",
      "executableName": "inertia",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Inertia",
          "Comment": "A calm local workspace for coding with agents.",
          "StartupWMClass": "Inertia"
        }
      },
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.217",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@opencode-ai/sdk": "1.18.4",
    "@tanstack/react-virtual": "3.14.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.25.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "20.11.1",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
