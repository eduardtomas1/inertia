# Copy to a root-readable environment file and replace the hostname. The state
# directory must live on durable storage and remain private to the relay user.
INERTIA_REMOTE_RELAY_HOST=127.0.0.1
INERTIA_REMOTE_RELAY_PORT=8787
INERTIA_REMOTE_RELAY_STATE_DIR=/var/lib/inertia-remote-relay
INERTIA_REMOTE_RELAY_INITIALIZE=1
INERTIA_REMOTE_ALLOWED_ORIGINS=https://replace-me.your-tailnet.ts.net

# Migration mode is intentionally absent. Never enable it for a new install.
